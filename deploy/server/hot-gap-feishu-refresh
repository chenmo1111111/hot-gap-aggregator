#!/usr/bin/env bash
set -Eeuo pipefail

project=/opt/hot-gap-aggregator
persistent_dir=/var/lib/hot-gap
data_dir=/var/www/hot-gap/data
refresh_stage=startup

notify_refresh_failure() {
  local failure_status="$1"
  local failure_line="$2"
  local failure_command="$3"
  local title message title_b64 message_b64 alert_status

  trap - ERR
  set +e
  title="HotGap refresh 失败"
  printf -v message \
    '主机：%s\n时间：%s\n阶段：%s\n退出码：%s\n脚本行：%s\n命令：%s\n日志：/var/log/hot-gap-feishu-sync.log' \
    "$(hostname)" "$(date --iso-8601=seconds)" "$refresh_stage" \
    "$failure_status" "$failure_line" "${failure_command:0:800}"
  title_b64="$(printf '%s' "$title" | /usr/bin/base64 -w 0)"
  message_b64="$(printf '%s' "$message" | /usr/bin/base64 -w 0)"
  "$project/.venv/bin/python" -m app.capture_monitor refresh-alert-b64 \
    --title-b64 "$title_b64" \
    --message-b64 "$message_b64" \
    --record "$persistent_dir/refresh-failures.jsonl"
  alert_status=$?
  if [[ $alert_status -ne 0 ]]; then
    echo "Refresh failure alert delivery failed with status $alert_status" >&2
  fi
  exit "$failure_status"
}

if [[ "${HOT_GAP_FEISHU_LOCKED:-}" != "1" ]]; then
  if /usr/bin/env HOT_GAP_FEISHU_LOCKED=1 \
    /usr/bin/flock -E 200 -w 300 /run/lock/hot-gap-feishu-sync.lock "$0"; then
    exit 0
  else
    status=$?
  fi
  if [[ $status -eq 200 ]]; then
    refresh_stage=lock_wait
    notify_refresh_failure "$status" "$LINENO" "flock wait exceeded 300 seconds"
  fi
  exit "$status"
fi

trap 'notify_refresh_failure "$?" "$LINENO" "$BASH_COMMAND"' ERR

# Acceptance runs and production refreshes must never let emergency seed rows
# hide a broken or empty government source.
export GONGKAO_DISABLE_SEEDS=true

alert_incoming=/home/deploy/.capture-alert.json.incoming
qiuzhao_incoming=/home/deploy/.qiuzhao_wanqing.json.incoming
qiuzhao_persistent="$persistent_dir/qiuzhao_wanqing.json"
qiuzhao_data="$data_dir/qiuzhao_wanqing.json"
gongkao_incoming=/home/deploy/.gongkao_sheet.json.incoming
gongkao_persistent="$persistent_dir/gongkao_sheet.json"
gongkao_data="$data_dir/gongkao_sheet.json"
xiaozhaoya_incoming=/home/deploy/.xiaozhaoya.json.incoming
xiaozhaoya_persistent="$persistent_dir/xiaozhaoya.json"
xiaozhaoya_data="$data_dir/xiaozhaoya.json"

cd "$project"
if [[ -f "$alert_incoming" ]]; then
  if "$project/.venv/bin/python" -m app.capture_monitor \
    alert-file --path "$alert_incoming"
  then
    /usr/bin/rm -f -- "$alert_incoming"
    echo "Capture alert relayed through S1 Feishu webhook"
    exit 0
  else
    rejected="${alert_incoming}.rejected.$(/usr/bin/date +%Y%m%d%H%M%S)"
    /usr/bin/mv -- "$alert_incoming" "$rejected"
    echo "Capture alert rejected; continuing the regular refresh" >&2
  fi
fi

/usr/bin/install -d -o root -g root -m 755 "$persistent_dir"
if [[ -f "$qiuzhao_incoming" ]]; then
  if "$project/.venv/bin/python" - "$qiuzhao_incoming" "$qiuzhao_persistent" <<'PY'
import json
import math
import sys

path, previous_path = sys.argv[1:3]
with open(path, encoding="utf-8") as handle:
    payload = json.load(handle)
items = payload.get("items") if isinstance(payload, dict) else None
previous_count = 0
try:
    with open(previous_path, encoding="utf-8") as handle:
        previous_count = len(json.load(handle).get("items") or [])
except (OSError, ValueError, TypeError):
    pass
minimum = math.ceil(previous_count * .9) if previous_count else 450
if not isinstance(items, list) or len(items) < minimum:
    raise SystemExit(f"incoming Wanqing snapshot failed validation: {len(items) if isinstance(items, list) else 0} < {minimum} (90% of previous)")
for index, item in enumerate(items):
    if not isinstance(item, dict) or not item.get("company_name") or not item.get("position"):
        raise SystemExit(f"incoming Wanqing snapshot has invalid item {index}")
PY
  then
    /usr/bin/install -o root -g root -m 644 "$qiuzhao_incoming" "$qiuzhao_persistent.tmp"
    /usr/bin/mv -f -- "$qiuzhao_persistent.tmp" "$qiuzhao_persistent"
    /usr/bin/rm -f -- "$qiuzhao_incoming"
  else
    rejected="${qiuzhao_incoming}.rejected.$(/usr/bin/date +%Y%m%d%H%M%S)"
    /usr/bin/mv -- "$qiuzhao_incoming" "$rejected"
    echo "Wanqing incoming rejected; previous snapshot retained at $qiuzhao_persistent" >&2
  fi
fi

if [[ -f "$gongkao_incoming" ]]; then
  if "$project/.venv/bin/python" - "$gongkao_incoming" "$gongkao_persistent" <<'PY'
import json
import math
import sys

path, previous_path = sys.argv[1:3]
with open(path, encoding="utf-8") as handle:
    payload = json.load(handle)
items = payload.get("items") if isinstance(payload, dict) else None
previous_count = 0
try:
    with open(previous_path, encoding="utf-8") as handle:
        previous_count = len(json.load(handle).get("items") or [])
except (OSError, ValueError, TypeError):
    pass
minimum = math.ceil(previous_count * .9) if previous_count else 500
if not isinstance(items, list) or len(items) < minimum:
    raise SystemExit(f"incoming Gongkao Sheet snapshot failed validation: {len(items) if isinstance(items, list) else 0} < {minimum} (90% of previous)")
for index, item in enumerate(items):
    extra = item.get("extra") if isinstance(item, dict) else None
    if (
        not isinstance(item, dict)
        or not item.get("title")
        or not str(item.get("url") or "").startswith(("http://", "https://"))
        or not isinstance(extra, dict)
        or not extra.get("id")
    ):
        raise SystemExit(f"incoming Gongkao Sheet snapshot has invalid item {index}")
PY
  then
    /usr/bin/install -o root -g root -m 644 "$gongkao_incoming" "$gongkao_persistent.tmp"
    /usr/bin/mv -f -- "$gongkao_persistent.tmp" "$gongkao_persistent"
    /usr/bin/rm -f -- "$gongkao_incoming"
  else
    rejected="${gongkao_incoming}.rejected.$(/usr/bin/date +%Y%m%d%H%M%S)"
    /usr/bin/mv -- "$gongkao_incoming" "$rejected"
    echo "Gongkao Sheet incoming rejected; previous snapshot retained at $gongkao_persistent" >&2
  fi
fi

if [[ -f "$xiaozhaoya_incoming" ]]; then
  if "$project/.venv/bin/python" - "$xiaozhaoya_incoming" "$xiaozhaoya_persistent" <<'PY'
import json
import math
import sys

path, previous_path = sys.argv[1:3]
with open(path, encoding="utf-8") as handle:
    payload = json.load(handle)
items = payload.get("items") if isinstance(payload, dict) else None
previous_count = 0
try:
    with open(previous_path, encoding="utf-8") as handle:
        previous_count = len(json.load(handle).get("items") or [])
except (OSError, ValueError, TypeError):
    pass
minimum = max(1000, math.ceil(previous_count * .8))
if not isinstance(items, list) or len(items) < minimum:
    raise SystemExit(f"incoming Xiaozhaoya snapshot failed validation: {len(items) if isinstance(items, list) else 0} < {minimum} (80% of previous)")
status = payload.get("status") if isinstance(payload.get("status"), dict) else {}
if payload.get("source") != "xiaozhaoya_feishu_base" or status.get("scheduled") is not False:
    raise SystemExit("incoming Xiaozhaoya snapshot is not a one-time Feishu Base backfill")
required = {"recruitmentId", "updateDate", "companyName", "jobTitle"}
for index, item in enumerate(items):
    if not isinstance(item, dict) or not required.issubset(item):
        raise SystemExit(f"incoming Xiaozhaoya snapshot has invalid item {index}")
PY
  then
    /usr/bin/install -o root -g root -m 644 "$xiaozhaoya_incoming" "$xiaozhaoya_persistent.tmp"
    /usr/bin/mv -f -- "$xiaozhaoya_persistent.tmp" "$xiaozhaoya_persistent"
    /usr/bin/rm -f -- "$xiaozhaoya_incoming"
  else
    rejected="${xiaozhaoya_incoming}.rejected.$(/usr/bin/date +%Y%m%d%H%M%S)"
    /usr/bin/mv -- "$xiaozhaoya_incoming" "$rejected"
    echo "Xiaozhaoya incoming rejected; previous snapshot retained at $xiaozhaoya_persistent" >&2
  fi
fi

if [[ -f "$qiuzhao_persistent" ]]; then
  /usr/bin/install -o deploy -g deploy -m 664 "$qiuzhao_persistent" "$qiuzhao_data"
fi
if [[ -f "$gongkao_persistent" ]]; then
  /usr/bin/install -o deploy -g deploy -m 664 "$gongkao_persistent" "$gongkao_data"
fi
if [[ -f "$xiaozhaoya_persistent" ]]; then
  /usr/bin/install -o deploy -g deploy -m 664 "$xiaozhaoya_persistent" "$xiaozhaoya_data"
fi

cleanup_stale_hot_gap_playwright() {
  local max_age_seconds="${HOT_GAP_PLAYWRIGHT_MAX_AGE_SECONDS:-600}"
  local pid elapsed command_line
  local -a stale_pids=()

  if [[ ! "$max_age_seconds" =~ ^[0-9]+$ ]]; then
    echo "Invalid HOT_GAP_PLAYWRIGHT_MAX_AGE_SECONDS=$max_age_seconds; using 600" >&2
    max_age_seconds=600
  fi

  while read -r pid elapsed command_line; do
    [[ "$pid" =~ ^[0-9]+$ && "$elapsed" =~ ^[0-9]+$ ]] || continue
    if (( elapsed >= max_age_seconds )) \
      && [[ "$command_line" == *"chromium"*"--headless"* ]] \
      && [[ "$command_line" == *"--hot-gap-gov-playwright"* ]]; then
      stale_pids+=("$pid")
    fi
  done < <(/usr/bin/ps -eo pid=,etimes=,args=)

  if (( ${#stale_pids[@]} == 0 )); then
    return
  fi

  echo "Stopping stale HotGap Playwright Chromium processes: ${stale_pids[*]}"
  /bin/kill -TERM "${stale_pids[@]}" 2>/dev/null || true
  /bin/sleep 2
  for pid in "${stale_pids[@]}"; do
    if /bin/kill -0 "$pid" 2>/dev/null; then
      /bin/kill -KILL "$pid" 2>/dev/null || true
    fi
  done
}

cd "$project"
if [[ -f "$xiaozhaoya_data" ]]; then
  refresh_stage=collect_xiaozhaoya
  .venv/bin/python -m app.collect_xiaozhaoya
fi
refresh_stage=cleanup_stale_playwright
cleanup_stale_hot_gap_playwright
refresh_stage=collect_gongkao
.venv/bin/python -m app.collect_gongkao
refresh_stage=export_qiuzhao
.venv/bin/python -m app.export_qiuzhao
refresh_stage=export_gongkao
.venv/bin/python -m app.export_gongkao
refresh_stage=export_recruitment_portals
.venv/bin/python -m app.recruitment_portals --output "$data_dir/portals.json"
refresh_stage=gongkao_enrich
.venv/bin/python -m app.pipeline.gongkao_enrich
refresh_stage=daily_volume
.venv/bin/python -m app.daily_volume
refresh_stage=sync_feishu
.venv/bin/python -m app.sync_feishu
refresh_stage=sync_feishu_public
.venv/bin/python -m app.sync_feishu_public
refresh_stage=notify_gongkao_digest
.venv/bin/python -m app.notify_gongkao_digest
refresh_stage=complete
