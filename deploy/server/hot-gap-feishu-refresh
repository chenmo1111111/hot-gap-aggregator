#!/usr/bin/env bash
set -euo pipefail

if [[ "${HOT_GAP_FEISHU_LOCKED:-}" != "1" ]]; then
  exec /usr/bin/env HOT_GAP_FEISHU_LOCKED=1 \
    /usr/bin/flock -w 300 /run/lock/hot-gap-feishu-sync.lock "$0"
fi

project=/opt/hot-gap-aggregator
incoming=/home/deploy/.qiuzhao_wanqing.json.incoming
persistent_dir=/var/lib/hot-gap
persistent_snapshot="$persistent_dir/qiuzhao_wanqing.json"
data_snapshot=/var/www/hot-gap/data/qiuzhao_wanqing.json

/usr/bin/install -d -o root -g root -m 755 "$persistent_dir"
if [[ -f "$incoming" ]]; then
  "$project/.venv/bin/python" - "$incoming" <<'PY'
import json
import sys

path = sys.argv[1]
with open(path, encoding="utf-8") as handle:
    payload = json.load(handle)
items = payload.get("items") if isinstance(payload, dict) else None
if not isinstance(items, list) or len(items) < 450:
    raise SystemExit("incoming Wanqing snapshot failed validation: expected at least 450 items")
for index, item in enumerate(items):
    if not isinstance(item, dict) or not item.get("company_name") or not item.get("position"):
        raise SystemExit(f"incoming Wanqing snapshot has invalid item {index}")
PY
  /usr/bin/install -o root -g root -m 644 "$incoming" "$persistent_snapshot.tmp"
  /usr/bin/mv -f -- "$persistent_snapshot.tmp" "$persistent_snapshot"
  /usr/bin/rm -f -- "$incoming"
fi

if [[ -f "$persistent_snapshot" ]]; then
  /usr/bin/install -o deploy -g deploy -m 664 "$persistent_snapshot" "$data_snapshot"
fi

cd "$project"
.venv/bin/python -m app.export_qiuzhao
.venv/bin/python -m app.sync_feishu
