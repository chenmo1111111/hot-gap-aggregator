#!/usr/bin/env bash
set -euo pipefail

if [[ $# -ne 2 ]]; then
  echo "usage: hot-gap-capture-alert TITLE_BASE64 MESSAGE_BASE64" >&2
  exit 2
fi
if [[ ! "$1" =~ ^[A-Za-z0-9+/=]+$ || ! "$2" =~ ^[A-Za-z0-9+/=]+$ ]]; then
  echo "alert arguments must be base64" >&2
  exit 2
fi
if (( ${#1} > 2048 || ${#2} > 16384 )); then
  echo "alert arguments are too long" >&2
  exit 2
fi

cd /opt/hot-gap-aggregator
exec .venv/bin/python -m app.capture_monitor \
  alert-b64 --title-b64 "$1" --message-b64 "$2"
