SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# Private six-account read-only inbox. Independent from both deadline reminders
# and hot-gap-feishu-refresh; staggered at minute 17 to avoid load spikes.
17 * * * * root cd /opt/hot-gap-aggregator && /usr/bin/flock -n /run/lock/hot-gap-mail-inbox.lock /usr/bin/timeout 40m /usr/bin/env MAILBOX_RUN_AS_USER=www-data .venv/bin/python -m app.mailbox.inbox_sync >> /var/log/hot-gap-mail-inbox.log 2>&1
