# SCS 官方国考源：写入 Actions 不会覆盖的 server-gongkao.json sidecar。
35 */2 * * * root cd /opt/hot-gap-aggregator && /opt/hot-gap-aggregator/.venv/bin/python -m app.server_run --scs --yingjiesheng >> /var/log/hot-gap-server.log 2>&1
# Main collector heartbeat: alert once when the two-hour job is over four hours stale.
20 * * * * root cd /opt/hot-gap-aggregator && /opt/hot-gap-aggregator/.venv/bin/python -m app.check_server_heartbeat --max-age-hours 4 >> /var/log/hot-gap-server.log 2>&1
# 人社局公告 + 核心补贴政策页 diff：每 12 小时。
45 */12 * * * root cd /opt/hot-gap-aggregator && /opt/hot-gap-aggregator/.venv/bin/python -m app.server_run --subsidy >> /var/log/hot-gap-server.log 2>&1
# 五省选调生官方公告：每 6 小时，黑龙江优先。
15 */6 * * * root cd /opt/hot-gap-aggregator && /opt/hot-gap-aggregator/.venv/bin/python -m app.server_run --xuandiao >> /var/log/hot-gap-server.log 2>&1
# 小红书电商规则：国内服务器 + 登录 Cookie，每 8 小时。
25 */8 * * * root cd /opt/hot-gap-aggregator && /opt/hot-gap-aggregator/.venv/bin/python -m app.server_run --xhs-rules >> /var/log/hot-gap-server.log 2>&1
# University employment sites are checked domestically; isolated from every other job.
55 */12 * * * root cd /opt/hot-gap-aggregator && /opt/hot-gap-aggregator/.venv/bin/python -m app.server_run --campus-jobs >> /var/log/hot-gap-server.log 2>&1
