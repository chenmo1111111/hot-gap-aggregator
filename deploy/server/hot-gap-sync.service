[Unit]
Description=Hot Gap account and preference sync API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/hot-gap-aggregator
EnvironmentFile=/etc/hot-gap-sync.env
Environment=PYTHONUNBUFFERED=1
UMask=0077
ExecStart=/opt/hot-gap-aggregator/.venv/bin/python -m uvicorn sync.app:app --host 127.0.0.1 --port 8787
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/hot-gap-sync

[Install]
WantedBy=multi-user.target
