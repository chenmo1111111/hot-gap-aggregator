# 只放在百度云服务器 /opt/hot-gap-aggregator/.env，不要提交真实值。
SERVER_DATABASE=data/server.db
SERVER_SITE_DATA_DIR=/var/www/hot-gap/data
SUBSIDY_SOURCES_CONFIG=config/subsidy_sources.yaml
XUANDIAO_SOURCES_CONFIG=config/xuandiao_sources.yaml
XHS_RULE_WATCH_CONFIG=config/xhs_rule_watch.yaml
CAMPUS_JOBS_CONFIG=config/campus_jobs_sources.yaml
YINGJIESHENG_CONFIG=config/yingjiesheng.yaml
YINGJIESHENG_ON_SERVER=true
SERVER_HEARTBEAT_PATH=/var/www/hot-gap/data/server-heartbeat.txt
# Cookie-Editor JSON array + browser Console document.cookie. Never commit real values.
XHS_SCHOOL_COOKIE_JSON=
XHS_SCHOOL_COOKIE_DOC=
GONGKAO_WATCH_CONFIG=config/gongkao_watch.yaml
ZHIPU_API_KEY=
DEEPSEEK_API_KEY=
BARK_URL=
FEISHU_WEBHOOK=
FEISHU_SIGN_SECRET=
SESSION_SECRET=
ADMIN_USER=
ADMIN_PASSWORD=
SYNC_DB_PATH=/var/lib/hot-gap-sync/sync.db
MAX_USERS=8
