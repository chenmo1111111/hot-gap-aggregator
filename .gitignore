# Local secrets (keep the documented template tracked)
.env*
!.env.example
!.env.server.example

# Dependencies and generated Python files
.venv/
node_modules/
__pycache__/
.pytest_cache/
coverage/
*.tsbuildinfo

# Local build/deploy outputs
dist/
web/dist/
site/
hot-gap-*.tar.gz
.openai/
.wrangler/
outputs/
work/
tmp/
.wanqing-browser/
.wanqing-state/

# SQLite transient files; data/hot.db is intentionally tracked
*.db-shm
*.db-wal
sync.db
public/data/server-*.json
# Contains private shop titles/categories and is generated only on the server.
data/xhs_shop_items.json
# Contains cached rule-sheet text and must never contain the access URL query.
data/xhs_external_docs.json

# Editor, OS and debug files
.DS_Store
*.pem
npm-debug.log*
debug.log
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
