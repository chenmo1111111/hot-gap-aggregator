# Translator chain: zhipu -> deepseek (if key set) -> free (MyMemory/Google).
# Put real values only in .env or GitHub Secrets. Override the primary with the
# repo variable / env TRANSLATOR (zhipu | deepseek | openai | free | none).
TRANSLATOR=zhipu
ZHIPU_API_KEY=

# Optional paid fallback, OpenAI-compatible. Set the key to activate.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Optional OpenAI-compatible fallback when TRANSLATOR=openai.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Summaries are generated for GitHub and YouTube; enabled by default.
ENABLE_SUMMARY=true

# Optional YouTube official API key. Without it, Invidious is used.
YOUTUBE_API_KEY=
INVIDIOUS_BASE=
INVIDIOUS_INSTANCES_CONFIG=config/invidious_instances.yaml

# Optional collector configuration paths.
TELEGRAM_CHANNELS_CONFIG=config/telegram_channels.yaml
XHS_KEYWORDS_CONFIG=config/xhs_keywords.yaml
GONGKAO_WATCH_CONFIG=config/gongkao_watch.yaml
PAPERS_CONFIG=config/papers.yaml
CONFERENCES_CONFIG=config/conferences.yaml
NOWCODER_CONFIG=config/nowcoder.yaml
RSSHUB_BASE=https://rsshub.app

# Optional NCBI E-utilities key. PubMed works without it; a key raises rate limits.
NCBI_API_KEY=

# Optional notification providers.
BARK_URL=
TG_BOT_TOKEN=
TG_CHAT_ID=
SERVERCHAN_KEY=
FEISHU_WEBHOOK=
FEISHU_SIGN_SECRET=

# Server-only domestic-site jobs. Keep false in GitHub Actions.
SCS_ENABLED=false
SUBSIDY_SOURCES_CONFIG=config/subsidy_sources.yaml
# Deprecated compatibility path for app.watchers.city_subsidy.
CITY_SUBSIDY_CONFIG=config/city_subsidy.yaml
SERVER_DATABASE=data/server.db
SERVER_SITE_DATA_DIR=/var/www/hot-gap/data

# Deployment-only values. Store real values as GitHub Secrets/Variables, not in .env.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
DEPLOY_TARGET=cloudflare
VITE_BASE_PATH=/
